{
  "task_id": "meeting_006",
  "domain": "meeting_prep",
  "difficulty": "hard",
  "initial_request": "経営合宿の事前準備として、役員向けの会議アジェンダと意思決定メモ、参加者向けブリーフをまとめてください。会場候補、参加者、予算制約を踏まえて、会議直前に使える状態まで整理したいです。",
  "initial_state": {
    "timezone": "Asia/Tokyo",
    "deadline": "2026-04-28T18:00:00+09:00",
    "participants": ["CEO", "COO", "CFO", "ChiefOfStaff", "StrategyLead"],
    "budget": 150000,
    "required_artifacts": [
      {
        "artifact_id": "agenda",
        "artifact_type": "document",
        "required_fields": ["meeting_goal", "agenda_items", "owners", "timeboxes"],
        "semantic_checks": [
          {
            "artifact_field": "participants",
            "state_path": "participants"
          },
          {
            "artifact_field": "deadline",
            "state_path": "deadline"
          }
        ]
      },
      {
        "artifact_id": "decision_memo",
        "artifact_type": "document",
        "required_fields": ["decision_topics", "options", "risks", "recommended_path"],
        "semantic_checks": [
          {
            "artifact_field": "budget",
            "state_path": "budget"
          }
        ]
      },
      {
        "artifact_id": "attendee_brief",
        "artifact_type": "document",
        "required_fields": ["context", "pre_reads", "logistics", "confidentiality_note"],
        "semantic_checks": [
          {
            "artifact_field": "share_policy",
            "state_path": "reference_data.share_policy"
          }
        ]
      }
    ],
    "constraints": [
      "会議時間は120分以内に収める",
      "CFOの予算承認前に会場を確定しない",
      "外部アドバイザーが参加する場合は機密資料を要約版に差し替える"
    ],
    "task_dependencies": [
      {
        "before": "confirm_budget_guardrail",
        "after": "lock_venue_plan",
        "reason": "予算上限が確定しないと会場を確定できない"
      },
      {
        "before": "define_decision_topics",
        "after": "draft_decision_memo",
        "reason": "意思決定テーマが固まってからメモを書く必要がある"
      },
      {
        "before": "check_share_policy",
        "after": "finalize_attendee_brief",
        "reason": "配布可能な情報範囲を確認してからブリーフを確定する"
      }
    ],
    "reference_data": {
      "share_policy": "internal only",
      "venue_mode": "offsite",
      "agenda_min_items": 4
    }
  },
  "allowed_actions": [
    "ask_clarification",
    "propose_plan",
    "update_plan",
    "create_artifact",
    "revise_artifact",
    "confirm_state",
    "finalize"
  ],
  "events": [
    {
      "turn": 2,
      "type": "stakeholder_change",
      "message": "外部アドバイザーが1名参加することになりました。配布資料は共有方針を見直してください。",
      "delta": {
        "participants_added": ["ExternalAdvisor"],
        "reference_data": {
          "share_policy": "split internal and advisor versions"
        }
      },
      "expected_artifact_updates": ["agenda", "attendee_brief"],
      "expected_replan_within_turns": 1
    },
    {
      "turn": 4,
      "type": "new_constraint",
      "message": "会場候補の見積もりが上がったため、総予算上限を12万円に下げて検討してください。",
      "delta": {
        "budget": 120000
      },
      "expected_artifact_updates": ["decision_memo", "attendee_brief"],
      "expected_replan_within_turns": 1
    }
  ],
  "goal_condition": {
    "must_satisfy_latest_state": true,
    "required_artifacts": ["agenda", "decision_memo", "attendee_brief"],
    "no_constraint_violation": true,
    "must_acknowledge_changes": true
  },
  "rubric": {
    "outcome": [
      "最終成果物が外部アドバイザー参加と最新の共有方針を反映している",
      "予算12万円上限に合わせて意思決定メモが更新されている",
      "agenda と attendee_brief が最新参加者・締切を反映している"
    ],
    "process": [
      "会場確定前に予算ガードレール確認タスクを置いている",
      "共有方針確認を attendee_brief 確定前の依存関係として扱っている"
    ],
    "recovery": [
      "各イベント後1ターン以内に再計画または状態確認を行う",
      "共有範囲と予算変更の両方を明示的に認識している"
    ]
  },
  "notes": "複数成果物と2段階の制約変更を含む、役員会準備の高難度ケース。"
}
