{
  "task_id": "meeting_003",
  "domain": "meeting_prep",
  "difficulty": "medium",
  "initial_request": "月次営業レビュー会議の準備をお願いします。CEO、COO、CFO、SalesLead が参加し、月次売上の確認と翌月計画を議論します。アジェンダとレビュー用スライドを用意してください。",
  "initial_state": {
    "timezone": "Asia/Tokyo",
    "deadline": "2026-04-20T10:00:00+09:00",
    "participants": ["CEO", "COO", "CFO", "SalesLead"],
    "budget": 80000,
    "required_artifacts": [
      {
        "artifact_id": "agenda",
        "artifact_type": "document",
        "required_fields": ["agenda_items", "decision_points", "timebox", "participant_availability_note"],
        "semantic_checks": [{"artifact_field": "participant_availability_note", "state_path": "reference_data.participant_availability_note"}],
        "latest_version_required": true
      },
      {
        "artifact_id": "review_deck",
        "artifact_type": "slides",
        "required_fields": ["revenue_summary", "forecast", "issues", "asks"],
        "semantic_checks": [{"artifact_field": "sales_snapshot_date", "state_path": "reference_data.sales_snapshot_date"}],
        "latest_version_required": true
      }
    ],
    "constraints": [
      "レビュー資料には最新の売上スナップショットを使う",
      "会議時間は 90 分以内に収める",
      "参加者制約が変わった場合は agenda を更新する"
    ],
    "task_dependencies": [
      {"before": "fetch_latest_sales", "after": "draft_review_deck", "reason": "最新数値取得後に資料を更新する必要がある"},
      {"before": "collect_availability", "after": "finalize_agenda", "reason": "参加制約確認後にアジェンダを確定する必要がある"}
    ],
    "reference_data": {
      "deck_version": "v1",
      "sales_snapshot_date": "2026-04-18",
      "participant_availability_note": "all participants available for full session",
      "topic": "monthly sales performance",
      "decision_goal": "confirm recovery actions and next-month forecast assumptions",
      "key_metrics": ["MRR", "new deals", "churn risk"]
    }
  },
  "allowed_actions": ["ask_clarification", "propose_plan", "update_plan", "create_artifact", "revise_artifact", "confirm_state", "finalize"],
  "events": [
    {
      "turn": 2,
      "type": "artifact_update",
      "message": "営業データの更新版が届き、資料バージョンが v2、スナップショット日付が 2026-04-19 に変わりました。",
      "delta": {
        "delta_applies_to": "initial_state",
        "reference_data": {
          "deck_version": "v2",
          "sales_snapshot_date": "2026-04-19"
        }
      },
      "expected_artifact_updates": ["review_deck"],
      "expected_tasks": ["fetch_latest_sales"],
      "expected_replan_within_turns": 1
    },
    {
      "turn": 4,
      "type": "stakeholder_change",
      "message": "CFO は最初の 30 分しか参加できないことが分かりました。",
      "delta": {
        "delta_applies_to": "initial_state",
        "reference_data": {
          "participant_availability_note": "CFO available first 30 minutes only"
        }
      },
      "expected_artifact_updates": ["agenda"],
      "expected_tasks": ["collect_availability"],
      "expected_replan_within_turns": 1
    }
  ],
  "goal_condition": {
    "must_satisfy_latest_state": true,
    "required_artifacts": ["agenda", "review_deck"],
    "no_constraint_violation": true,
    "must_acknowledge_changes": true
  },
  "rubric": {
    "outcome": [
      "review_deck が最新 sales_snapshot_date を反映している",
      "agenda が CFO の参加制約に合わせて更新されている"
    ],
    "process": [
      "turn 2 の artifact_update 後に古い資料を使い続けず review_deck を更新している",
      "turn 4 の stakeholder_change 後に collect_availability を反映して agenda を更新している"
    ],
    "recovery": ["各イベント後 1 ターン以内に更新または再計画を行っている"]
  },
  "notes": "medium ケース。資料更新と参加制約変更の両方に追随する。"
}
