{
  "task_id": "meeting_008",
  "domain": "meeting_prep",
  "difficulty": "hard",
  "initial_request": "新機能ローンチ判定会議の準備をお願いします。会議アジェンダ、ローンチ判定用の readout、リスク登録表を整備して、GO/NO-GO を決められる状態にしたいです。",
  "initial_state": {
    "timezone": "Asia/Tokyo",
    "deadline": "2026-05-08T14:00:00+09:00",
    "participants": ["PM", "EngineeringManager", "MarketingLead", "SupportManager", "QA"],
    "budget": 60000,
    "required_artifacts": [
      {
        "artifact_id": "agenda",
        "artifact_type": "document",
        "required_fields": ["decision_goal", "agenda_items", "owners", "decision_criteria"],
        "semantic_checks": [
          {
            "artifact_field": "deadline",
            "state_path": "deadline"
          }
        ]
      },
      {
        "artifact_id": "launch_readout",
        "artifact_type": "document",
        "required_fields": ["launch_scope", "readiness_summary", "metrics_snapshot", "open_issues"],
        "semantic_checks": [
          {
            "artifact_field": "release_candidate",
            "state_path": "reference_data.release_candidate"
          }
        ]
      },
      {
        "artifact_id": "risk_register",
        "artifact_type": "document",
        "required_fields": ["top_risks", "mitigations", "owners", "escalation_rule"],
        "semantic_checks": [
          {
            "artifact_field": "launch_date",
            "state_path": "reference_data.launch_date"
          }
        ]
      }
    ],
    "constraints": [
      "QA のサインオフなしに GO 判定しない",
      "ローンチ日変更があればすべての成果物に反映する",
      "high リスクは owner と mitigation が両方埋まるまで未解決扱いにする"
    ],
    "task_dependencies": [
      {
        "before": "collect_readiness_inputs",
        "after": "draft_launch_readout",
        "reason": "部門別の状況を回収してから readout を起草する"
      },
      {
        "before": "refresh_open_risks",
        "after": "finalize_risk_register",
        "reason": "最新リスクを反映してから最終化する必要がある"
      },
      {
        "before": "confirm_qa_signoff_status",
        "after": "finalize_launch_readout",
        "reason": "判定材料として QA 状況を含める必要がある"
      }
    ],
    "reference_data": {
      "launch_date": "2026-05-15",
      "release_candidate": "rc1",
      "qa_signoff": "pending"
    }
  },
  "allowed_actions": [
    "ask_clarification",
    "propose_plan",
    "update_plan",
    "create_artifact",
    "revise_artifact",
    "confirm_state",
    "finalize"
  ],
  "events": [
    {
      "turn": 2,
      "type": "artifact_update",
      "message": "開発から新しいリリース候補 rc2 が共有されました。readout の前提を更新してください。",
      "delta": {
        "reference_data": {
          "release_candidate": "rc2"
        }
      },
      "expected_artifact_updates": ["launch_readout"],
      "expected_replan_within_turns": 1
    },
    {
      "turn": 4,
      "type": "state_change",
      "message": "ローンチ日が 2026-05-12 に前倒しされ、法務担当も判定会議に参加します。",
      "delta": {
        "participants_added": ["Legal"],
        "reference_data": {
          "launch_date": "2026-05-12"
        }
      },
      "expected_artifact_updates": ["agenda", "risk_register", "launch_readout"],
      "expected_replan_within_turns": 1
    }
  ],
  "goal_condition": {
    "must_satisfy_latest_state": true,
    "required_artifacts": ["agenda", "launch_readout", "risk_register"],
    "no_constraint_violation": true,
    "must_acknowledge_changes": true
  },
  "rubric": {
    "outcome": [
      "launch_readout が最新の release candidate を反映している",
      "risk_register が前倒し後の launch_date を保持している",
      "agenda が参加者追加と最新判断条件を反映している"
    ],
    "process": [
      "QA サインオフ確認を最終化前の依存関係に置いている",
      "リスク更新を readout 更新と分離して整理している"
    ],
    "recovery": [
      "rc2 共有とローンチ前倒しの両イベントで即座に再計画する",
      "更新が必要な3成果物を漏れなく見直す"
    ]
  },
  "notes": "製品ローンチ判定会議。複数成果物にまたがる state 追従を確認しやすい。"
}
