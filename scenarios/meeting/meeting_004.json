{
  "task_id": "meeting_004",
  "domain": "meeting_prep",
  "difficulty": "medium",
  "initial_request": "採用計画レビュー会議を準備してください。HR、HiringManager、Ops が参加し、次四半期の採用人数と面接枠拡張可否を議論します。アジェンダと会議メモを作成してください。",
  "initial_state": {
    "timezone": "Asia/Tokyo",
    "deadline": "2026-04-22T15:00:00+09:00",
    "participants": ["HR", "HiringManager", "Ops"],
    "budget": 20000,
    "ops_approval_available": true,
    "required_artifacts": [
      {
        "artifact_id": "agenda",
        "artifact_type": "document",
        "required_fields": ["objective", "topics", "owner"],
        "semantic_checks": [
          {"artifact_field": "approval_mode", "state_path": "reference_data.approval_mode"},
          {"artifact_field": "ops_approval_available", "state_path": "ops_approval_available"}
        ],
        "latest_version_required": true
      },
      {
        "artifact_id": "meeting_memo",
        "artifact_type": "document",
        "required_fields": ["hiring_plan", "interview_capacity", "risks", "approval_mode"],
        "semantic_checks": [
          {"artifact_field": "forecast_hires", "state_path": "reference_data.forecast_hires"},
          {"artifact_field": "approval_mode", "state_path": "reference_data.approval_mode"}
        ],
        "latest_version_required": true
      }
    ],
    "constraints": [
      "Ops の確認なしに面接枠拡張を確定しない",
      "meeting_memo には最新の採用人数見込みを反映する"
    ],
    "task_dependencies": [
      {"before": "collect_hiring_forecast", "after": "draft_meeting_memo", "reason": "採用人数見込み取得後にメモを更新する必要がある"},
      {"before": "ops_approval", "after": "finalize_interview_capacity", "reason": "Ops 確認後に面接枠判断を確定する必要がある"}
    ],
    "reference_data": {
      "forecast_hires": 6,
      "topic": "quarterly hiring plan review",
      "roles_in_scope": ["sales", "support", "backend engineer"],
      "decision_goal": "decide whether to expand interview capacity",
      "approval_mode": "live approval in meeting"
    }
  },
  "allowed_actions": ["ask_clarification", "propose_plan", "update_plan", "create_artifact", "revise_artifact", "confirm_state", "finalize"],
  "events": [
    {
      "turn": 3,
      "type": "state_change",
      "message": "採用人数見込みが 6 から 9 に上方修正されました。",
      "delta": {
        "delta_applies_to": "initial_state",
        "reference_data": {
          "forecast_hires": 9
        }
      },
      "expected_artifact_updates": ["meeting_memo"],
      "expected_tasks": ["collect_hiring_forecast"],
      "expected_replan_within_turns": 1
    },
    {
      "turn": 5,
      "type": "stakeholder_change",
      "message": "Ops は当日参加できず、事前コメントベースで判断する必要があると分かりました。",
      "delta": {
        "delta_applies_to": "initial_state",
        "ops_approval_available": false,
        "reference_data": {
          "approval_mode": "async comments before meeting"
        }
      },
      "expected_artifact_updates": ["agenda", "meeting_memo"],
      "expected_tasks": ["ops_approval"],
      "expected_replan_within_turns": 1
    }
  ],
  "goal_condition": {
    "must_satisfy_latest_state": true,
    "required_artifacts": ["agenda", "meeting_memo"],
    "no_constraint_violation": true,
    "must_acknowledge_changes": true
  },
  "rubric": {
    "outcome": [
      "meeting_memo が forecast_hires=9 を反映している",
      "agenda と meeting_memo が async comments before meeting に更新されている"
    ],
    "process": [
      "turn 3 後に採用人数見込み更新を先に反映している",
      "turn 5 後に Ops 参加前提のまま finalize せず approval_mode を更新している"
    ],
    "recovery": ["各イベント後 1 ターン以内に更新または再計画を行っている"]
  },
  "notes": "medium ケース。数値変更と承認モード変更への追随を同時に見る。"
}
