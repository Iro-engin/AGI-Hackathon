    "participants": ["PM", "FinanceSystemsLead", "PlatformLead", "SupportOps"],
    "budget": 70000,
    "required_artifacts": [
      {
        "artifact_id": "agenda",
        "artifact_type": "document",
        "required_fields": ["meeting_goal", "agenda_items", "owners", "decision_criteria"],
        "semantic_checks": [
          {
            "artifact_field": "migration_scope",
            "state_path": "reference_data.migration_scope"
          },
          {
            "artifact_field": "scope_decision_status",
            "state_path": "reference_data.scope_decision_status"
          }
        ]
      },
      {
        "artifact_id": "migration_memo",
        "artifact_type": "document",
        "required_fields": ["scope_options", "readiness_gaps", "recommended_path", "open_questions"],
        "semantic_checks": [
          {
            "artifact_field": "target_date",
            "state_path": "reference_data.target_date"
          },
          {
            "artifact_field": "migration_scope",
            "state_path": "reference_data.migration_scope"
          },
          {
            "artifact_field": "scope_decision_status",
            "state_path": "reference_data.scope_decision_status"
          }
        ]
      }
    ],
    "constraints": [
      "決済影響のある移行は SupportOps の対応方針が不明なまま確定しない",
      "会議時間は75分以内にする",
      "対象範囲が未確定な場合は ask_clarification を行ってから確定案に進む",
      "reference_data.scope_decision_status が confirmed 以外のまま finalize しない"
    ],
    "task_dependencies": [
      {
        "before": "confirm_migration_scope",
        "after": "draft_migration_memo",
        "reason": "対象範囲の定義がないと判定メモを確定できない"
      },
      {
        "before": "collect_support_impact",
        "after": "finalize_migration_memo",
        "reason": "サポート影響を踏まえて推奨案を整理する必要がある"
      }
    ],
    "reference_data": {
      "migration_scope": "all existing customers",
      "scope_decision_status": "confirmed",
      "target_date": "2026-06-10",
      "topic": "billing platform migration review",
      "decision_goal": "choose full migration or scoped migration",
      "scope_options": [
        "all existing customers",
        "new customers only",
        "one pilot segment only"
      ]
    }
  },
  "allowed_actions": [
    "ask_clarification",
    "propose_plan",
    "update_plan",
    "create_artifact",
    "revise_artifact",
    "confirm_state",
    "finalize"
  ],
  "events": [
    {
      "turn": 2,
      "type": "state_change",
      "message": "PlatformLead から、既存顧客全体移行は6月に間に合わないと共有がありました。対象範囲を見直してください。",
