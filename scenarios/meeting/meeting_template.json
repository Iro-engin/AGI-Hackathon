{
  "task_id": "meeting_TEMPLATE_001",
  "domain": "meeting_prep",
  "difficulty": "easy",
  "initial_request": "<会議準備の依頼文を入れる。会議テーマ、参加者、欲しい成果物、意思決定したい内容を書く>",
  "initial_state": {
    "timezone": "Asia/Tokyo",
    "deadline": "2026-06-01T17:00:00+09:00",
    "participants": ["<ParticipantA>", "<ParticipantB>", "<ParticipantC>"],
    "budget": 50000,
    "required_artifacts": [
      {
        "artifact_id": "agenda",
        "artifact_type": "document",
        "required_fields": [
          "meeting_goal",
          "agenda_items",
          "owners",
          "time_allocation"
        ],
        "semantic_checks": [
          {
            "artifact_field": "participants",
            "state_path": "participants"
          },
          {
            "artifact_field": "deadline",
            "state_path": "deadline"
          }
        ],
        "latest_version_required": true
      },
      {
        "artifact_id": "briefing_doc",
        "artifact_type": "document",
        "required_fields": [
          "summary",
          "decision_points",
          "risks",
          "next_actions"
        ],
        "semantic_checks": [
          {
            "artifact_field": "participants",
            "state_path": "participants"
          },
          {
            "artifact_field": "deadline",
            "state_path": "deadline"
          },
          {
            "artifact_field": "topic",
            "state_path": "reference_data.topic"
          }
        ],
        "latest_version_required": true
      }
    ],
    "constraints": [
      "<制約1: 参加者全員の空き時間が分かるまで会議時刻を確定しない>",
      "<制約2: 会議時間の上限を入れる>",
      "<制約3: briefing_doc に必ず含めたい内容を書く>",
      "<制約4: 曖昧状態では ask_clarification を要求する場合はここに書く>"
    ],
    "task_dependencies": [
      {
        "before": "collect_availability",
        "after": "propose_schedule",
        "reason": "参加可能時間を確認してから会議時刻を提案する必要がある"
      },
      {
        "before": "define_agenda",
        "after": "write_briefing_doc",
        "reason": "論点を固めてから事前共有メモを書く必要がある"
      }
    ],
    "reference_data": {
      "meeting_type": "<例: executive review / migration review / planning sync>",
      "topic": "<会議テーマ>",
      "decision_goal": "<この会議で決めたいこと>",
      "agenda_min_items": 3,
      "known_options": [
        "<比較候補1>",
        "<比較候補2>",
        "<比較候補3>"
      ],
      "scope_status": "<confirmed / ambiguous / reduction_required など必要なら入れる>",
      "share_policy": "<必要なら internal only などを入れる>"
    }
  },
  "allowed_actions": [
    "ask_clarification",
    "propose_plan",
    "update_plan",
    "create_artifact",
    "revise_artifact",
    "confirm_state",
    "finalize"
  ],
  "events": [
    {
      "turn": 3,
      "type": "state_change",
      "message": "<途中で起こる変更を書く。参加者追加、締切前倒し、予算変更など>",
      "delta": {
        "participants_added": ["<NewParticipant>"],
        "deadline": "2026-05-31T12:00:00+09:00"
      },
      "expected_artifact_updates": ["agenda", "briefing_doc"],
      "expected_replan_within_turns": 2
    },
    {
      "turn": 4,
      "type": "ambiguity",
      "message": "<必要なら曖昧化イベントを入れる。複数候補が競合し、追加確認が必要な状況を書く>",
      "delta": {
        "reference_data": {
          "scope_status": "ambiguous",
          "known_options": ["<候補A>", "<候補B>"]
        }
      },
      "expected_artifact_updates": ["briefing_doc"],
      "expected_replan_within_turns": 1
    }
  ],
  "goal_condition": {
    "must_satisfy_latest_state": true,
    "required_artifacts": ["agenda", "briefing_doc"],
    "no_constraint_violation": true,
    "must_acknowledge_changes": true
  },
  "rubric": {
    "outcome": [
      "<最終成果物が最新の参加者・締切・必要 state を反映している>",
      "<briefing_doc または相当成果物が会議テーマに必要な比較や意思決定論点を含んでいる>",
      "<成果物同士で参加者・期限・主要前提が整合している>"
    ],
    "process": [
      "<依存関係に沿って会議準備を進めている>",
      "<必要なら ask_clarification を使い、曖昧なまま確定しない>",
      "<event 後に旧前提のまま進めず、影響範囲のある成果物を更新している>"
    ],
    "recovery": [
      "<event 発生後 N ターン以内に状態更新または再計画を行う>",
      "<参加者追加・締切変更・曖昧化などの主要変化を明示的に認識している>"
    ]
  },
  "notes": "meeting_001 をベースにした量産用テンプレート。最低限、required_artifacts / task_dependencies / events / goal_condition / rubric を埋めてから個別ケース化する。質問能力を測りたいケースでは、constraints と event で曖昧状態を明示し、rubric.process に ask_clarification を含める。"
}
