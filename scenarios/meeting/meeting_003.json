{
  "task_id": "meeting_003",
  "domain": "meeting_prep",
  "difficulty": "medium",
  "initial_request": "月次営業レビュー会議の準備をお願いします。CEO、COO、CFO、営業責任者が参加し、4月の売上進捗と来月の見通しを確認します。会議アジェンダとレビュー用スライドを作り、経営判断に必要な数字と論点を整理してください。",
  "initial_state": {
    "timezone": "Asia/Tokyo",
    "deadline": "2026-04-20T10:00:00+09:00",
    "participants": [
      "CEO",
      "COO",
      "CFO",
      "SalesLead"
    ],
    "budget": 80000,
    "required_artifacts": [
      {
        "artifact_id": "agenda",
        "artifact_type": "document",
        "required_fields": [
          "agenda_items",
          "decision_points",
          "timebox",
          "participant_availability_note"
        ],
        "semantic_checks": [
          {
            "artifact_field": "participant_availability_note",
            "state_path": "reference_data.participant_availability_note"
          }
        ],
        "latest_version_required": true
      },
      {
        "artifact_id": "review_deck",
        "artifact_type": "slides",
        "required_fields": [
          "revenue_summary",
          "forecast",
          "issues",
          "asks"
        ],
        "semantic_checks": [
          {
            "artifact_field": "sales_snapshot_date",
            "state_path": "reference_data.sales_snapshot_date"
          }
        ],
        "latest_version_required": true
      }
    ],
    "constraints": [
      "レビュー資料には最新の売上スナップショットを使う",
      "会議時間は90分以内に収める",
      "参加者全員が見られる要点サマリを最初に置く"
    ],
    "task_dependencies": [
      {
        "before": "fetch_latest_sales",
        "after": "draft_review_deck",
        "reason": "最新データを取得してからレビュー資料を作る必要がある"
      },
      {
        "before": "draft_review_deck",
        "after": "final_review_deck",
        "reason": "ドラフト確認を経ずに最終版にはできない"
      }
    ],
    "reference_data": {
      "deck_version": "v1",
      "sales_snapshot_date": "2026-04-18",
      "participant_availability_note": "all participants available for full session",
      "topic": "monthly sales performance",
      "decision_goal": "confirm April recovery actions and May forecast assumptions",
      "key_metrics": [
        "MRR",
        "new deals",
        "churn risk"
      ]
    }
  },
  "allowed_actions": [
    "ask_clarification",
    "propose_plan",
    "update_plan",
    "create_artifact",
    "revise_artifact",
    "confirm_state",
    "finalize"
  ],
  "events": [
    {
      "turn": 2,
      "type": "artifact_update",
      "message": "営業データの最新集計が届き、資料の版が v2 に更新されました。売上見込みも一部修正が必要です。",
      "delta": {
        "reference_data": {
          "deck_version": "v2",
          "sales_snapshot_date": "2026-04-19"
        }
      },
      "expected_artifact_updates": [
        "review_deck"
      ],
      "expected_replan_within_turns": 1
    },
    {
      "turn": 4,
      "type": "stakeholder_change",
      "message": "CFO は冒頭30分しか参加できなくなりました。利益率に関する論点を前半に移してください。",
      "delta": {
        "reference_data": {
          "participant_availability_note": "CFO available first 30 minutes only"
        }
      },
      "expected_artifact_updates": [
        "agenda"
      ],
      "expected_replan_within_turns": 1
    }
  ],
  "goal_condition": {
    "must_satisfy_latest_state": true,
    "required_artifacts": [
      "agenda",
      "review_deck"
    ],
    "no_constraint_violation": true,
    "must_acknowledge_changes": true
  },
  "rubric": {
    "outcome": [
      "review_deck が最新の sales_snapshot_date を反映している",
      "agenda が CFO の参加制約に合わせて論点順を調整している"
    ],
    "process": [
      "v1 のまま固めず、v2 の更新を受けて資料を見直している",
      "参加可能時間の変化を踏まえて会議構成を更新している"
    ],
    "recovery": [
      "2つのイベントの両方に対して適切な成果物更新を行っている"
    ]
  },
  "notes": "数字更新と参加者制約の両方が発生する営業レビューケース。"
}
