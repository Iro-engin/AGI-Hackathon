{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution_log.schema.json",
  "title": "Dynamic Agent Correctness Benchmark Execution Log",
  "description": "Schema for an execution log that records planning, clarifications, task decomposition, and final outputs.",
  "type": "object",
  "required": [
    "task_id",
    "actions",
    "completed_tasks",
    "final_state",
    "final_artifacts"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "completed_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_breakdown": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taskBreakdownItem"
      }
    },
    "questions_asked": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "constraint_violations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unsafe_commit": {
      "type": "boolean",
      "default": false
    },
    "final_state": {
      "type": "object",
      "additionalProperties": true
    },
    "final_artifacts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/finalArtifact"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "turn",
        "action_type"
      ],
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "action_type": {
          "type": "string"
        },
        "acknowledged_event_turns": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "artifact_updates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "taskBreakdownItem": {
      "type": "object",
      "required": [
        "task_id",
        "description"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": [
        "turn",
        "question"
      ],
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "blocks_tasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "finalArtifact": {
      "type": "object",
      "properties": {
        "fields_completed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_values": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
